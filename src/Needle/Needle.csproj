<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>Needle</RootNamespace>
    <AssemblyName>Needle.Inference</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);NEEDLE_SIMD</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NeedleAllocCounters)' == 'true'">
    <DefineConstants>$(DefineConstants);NEEDLE_ALLOC_COUNTERS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <NoWarn>$(NoWarn);CS0162</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Needle.Tests" />
    <InternalsVisibleTo Include="needle" />
    <InternalsVisibleTo Include="Needle.Unity" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
  </ItemGroup>
</Project>
