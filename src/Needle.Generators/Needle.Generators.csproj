<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Needle.Generators</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" PrivateAssets="all" />
  </ItemGroup>
  <!-- tools/pack-unity.sh stamps the generator it ships in the Unity package with a hash of these
       sources, so its check mode can tell when the committed Analyzers/Needle.Generators.dll is stale. -->
  <ItemGroup Condition="'$(NeedleSourceStamp)' != ''">
    <AssemblyMetadata Include="Needle.SourceStamp" Value="$(NeedleSourceStamp)" />
  </ItemGroup>
</Project>
