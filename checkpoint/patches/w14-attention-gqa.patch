+    static Vector256<float> ScaleVector(in AttentionTile tile)
+    {
+        var lanes = stackalloc float[Lanes];
+        for (var h = 0; h < Lanes; h++) lanes[h] = h < tile.Heads ? tile.QueryScales[h] * InverseSqrtQkDim : 0f;
+        return Avx.LoadVector256(lanes);
+    }
