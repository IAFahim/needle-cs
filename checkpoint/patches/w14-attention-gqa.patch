+        var scale = Vector256.Create(factor);
+        Avx.Store(output, Avx.Multiply(a0, scale));
+        Avx.Store(output + 8, Avx.Multiply(a1, scale));
+        Avx.Store(output + 16, Avx.Multiply(a2, scale));
+        Avx.Store(output + 24, Avx.Multiply(a3, scale));
+    }
